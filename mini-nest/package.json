{
  "name": "mini-nest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "watch": "tsc --watch",
    "serve": "nodemon --watch dist --ext js --exec \"node dist/src/index.js\"",
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "test": "node --test dist/test/*.test.js",
    "test:local": "npm run build && node --test dist/test/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  }
}
