# Port used by the NestJS HTTP server.
PORT=3000

# PostgreSQL host name used by the application.
DB_HOST=postgres

# PostgreSQL port.
DB_PORT=5432

# PostgreSQL database name.
DB_NAME=r_d__marketplace

# PostgreSQL user used by the application.
DB_USER=user

# Path to the file containing the PostgreSQL password. Do not put the password itself here.
DB_PASSWORD_FILE=./secrets/db_password